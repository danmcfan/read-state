{
  "name": "read-state",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "bunx --bun vite",
    "build": "bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "build:wasm": "scripts/build-wasm.sh",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives && bun scripts/lint-guards.ts",
    "lint:native": "golangci-lint run ./... && GOOS=js GOARCH=wasm golangci-lint run ./cmd/... && cargo fmt --check && cargo clippy --all-targets --quiet -- -D warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --no-progress",
    "test": "bun test",
    "test:native": "go vet ./... && go test ./... && cargo test --quiet",
    "verify": "bun scripts/verify.ts",
    "sandcastle": "bun .sandcastle/main.ts",
    "sandcastle:batch": "bun .sandcastle/batch.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run lint:native && bun run knip && bun test && bun run build && bun run test:native"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "@standard-schema/spec": "^1.1.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "knip": "6.41.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "sandworm": "link:sandworm",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
