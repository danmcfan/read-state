{
  "name": "read-state",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "bun scripts/serve.ts",
    "build": "bun scripts/build.ts",
    "build:wasm": "scripts/build-wasm.sh",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives && bun scripts/lint-guards.ts",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --no-progress",
    "test": "bun test",
    "test:native": "go vet ./... && go test ./... && cargo test --quiet",
    "verify": "bun scripts/verify.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run knip && bun test && bun run build && bun run test:native"
  },
  "dependencies": {
    "solid-js": "1.9.17"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-syntax-typescript": "7.29.7",
    "@types/babel__core": "7.20.5",
    "@types/bun": "1.4.2",
    "babel-preset-solid": "1.9.16",
    "knip": "6.41.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
