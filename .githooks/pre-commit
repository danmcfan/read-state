#!/bin/sh
# Format and lint-fix the staged files before each commit; the full gate
# (`bun run check`) runs on pre-push and in CI. Installed by `bun install`.
set -e

files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$files" ] && exit 0

# Refuse partially staged files: fixing them would sweep unstaged edits in.
partial=$(git diff --name-only -- $files)
if [ -n "$partial" ]; then
  echo "pre-commit: stage or stash the rest of these files first:" >&2
  echo "$partial" >&2
  exit 1
fi

echo "$files" | xargs bunx prettier --write --ignore-unknown --log-level warn
ts=$(echo "$files" | grep -E '\.tsx?$' || true)
if [ -n "$ts" ]; then
  echo "$ts" | xargs bunx oxlint --type-aware --fix --deny-warnings --report-unused-disable-directives
fi
go=$(echo "$files" | grep -E '\.go$' || true)
if [ -n "$go" ]; then
  echo "$go" | xargs golangci-lint fmt
fi
rs=$(echo "$files" | grep -E '\.rs$' || true)
if [ -n "$rs" ]; then
  echo "$rs" | xargs rustfmt --edition 2021
fi
bun scripts/lint-guards.ts
echo "$files" | xargs git add
